# Blog configuration example
# Copy this file to .blogrc and customize. .blogrc is gitignored.
# Variables already exported in the environment (e.g. CI secrets) take
# precedence over values set here; see config.sh.

# Site metadata
export BLOG_TITLE="bytenoob"
export BLOG_DESCRIPTION="A technical blog about programming and technology"
export BLOG_URL="https://bytenoob.io"

# Author information
export BLOG_AUTHOR="Your Name"
export BLOG_EMAIL="your.email@example.com"
export GITHUB_USERNAME="your-github-username"
# X/Twitter handle without @ (share links "via" and card attribution)
export TWITTER_USERNAME="your-x-handle"

# Enable incremental builds (only rebuild changed files)
# export INCREMENTAL_BUILD=true
